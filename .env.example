# VANTARA AI environment configuration
# Copy to .env and export the values you need. Never commit real secrets.

# --- Storage ---------------------------------------------------------------
# VANTARA_DATA_DIR=./data
# VANTARA_MODELS_DIR=./data/models
# VANTARA_UPLOADS_DIR=./data/uploads
# VANTARA_OUTPUTS_DIR=./data/outputs
# VANTARA_DB_PATH=./data/vantara.db

# --- Server ----------------------------------------------------------------
# Bind to loopback by default. Exposing VANTARA to a network requires an
# authenticated reverse proxy and a reviewed CORS configuration.
VANTARA_HOST=127.0.0.1
VANTARA_PORT=8756
VANTARA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# VANTARA_REQUEST_MAX_BYTES=33554432
# VANTARA_RATE_LIMIT=600

# --- llama.cpp managed runtime --------------------------------------------
# Path to a llama-server binary. Defaults to vendor/llama.cpp/llama-server.
# VANTARA_LLAMA_SERVER=/absolute/path/to/llama-server
# VANTARA_LLAMA_PORT=8199
# VANTARA_LLAMA_CONTEXT=4096
# VANTARA_LLAMA_THREADS=4

# --- Ollama (optional) -----------------------------------------------------
# VANTARA_OLLAMA_URL=http://127.0.0.1:11434

# --- Hugging Face ----------------------------------------------------------
# Required only for gated/private repositories or higher rate limits.
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxx
# VANTARA_HF_API_BASE=https://huggingface.co

# --- Explicit opt-ins ------------------------------------------------------
# Remote providers are still disabled per-user in Settings unless explicitly
# selected. The setting below is informational for deployments.
# VANTARA_ALLOW_REMOTE_PROVIDERS=false
# Allow workflow HTTP Request nodes. This enables outbound network access from
# workflows you run; SSRF guards still block private addresses.
# VANTARA_ALLOW_WORKFLOW_HTTP=false

# --- Corporate TLS ---------------------------------------------------------
# Point this at your CA bundle if HTTPS requests fail behind an inspection proxy.
# REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
